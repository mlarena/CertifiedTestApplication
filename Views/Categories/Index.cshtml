@model dynamic

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Категории тестов</h2>
    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createModal">
        Добавить категорию
    </button>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show small py-2" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="table-responsive">
    <table class="table table-hover border align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th style="width: 50px;">№</th>
                <th>Название категории</th>
                <th style="width: 140px;" class="text-center">Кол-во тестов</th>
                <th style="width: 180px;" class="text-end">Действия</th>
            </tr>
        </thead>
        <tbody>
            @{ int rowNum = 0; }
            @foreach (var item in Model)
            {
                rowNum++;
                var cat = item.Category as CertifiedTestApplication.Models.Entities.Category;
                <tr>
                    <td class="text-muted">@rowNum</td>
                    <td><strong>@cat?.Name</strong></td>
                    <td class="text-center">
                        @if ((int)item.TestsCount > 0)
                        {
                            <span class="badge bg-info">@item.TestsCount</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td class="text-end">
                        <button type="button" class="btn btn-outline-primary btn-sm py-0"
                                data-bs-toggle="modal" data-bs-target="#editModal"
                                data-id="@cat?.Id" data-name="@cat?.Name">
                            Редактировать
                        </button>
                        @if ((int)item.TestsCount == 0)
                        {
                            <form asp-action="Delete" asp-route-id="@cat?.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm py-0"
                                        onclick="return confirm('Удалить категорию «@cat?.Name»?')">
                                    Удалить
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal: Создание категории -->
<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header py-2">
                    <h6 class="modal-title">Новая категория</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label small">Название</label>
                        <input name="name" class="form-control form-control-sm" placeholder="Введите название"
                               maxlength="200" required autofocus />
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-primary btn-sm">Создать</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Редактирование категории -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="editForm" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editId" />
                <div class="modal-header py-2">
                    <h6 class="modal-title">Редактировать категорию</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label small">Название</label>
                        <input name="name" id="editName" class="form-control form-control-sm"
                               maxlength="200" required />
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-primary btn-sm">Сохранить</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const editModal = document.getElementById('editModal');
        editModal.addEventListener('show.bs.modal', function (event) {
            const btn = event.relatedTarget;
            document.getElementById('editId').value = btn.dataset.id;
            document.getElementById('editName').value = btn.dataset.name;
            setTimeout(() => document.getElementById('editName').focus(), 100);
        });
    </script>
}
